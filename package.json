{
  "name": "jito-docs-validator",
  "version": "1.0.0",
  "description": "Documentation structure validator for Jito Omnidocs",
  "main": "validate-docs-structure.js",
  "bin": {
    "validate-docs": "./validate-docs-structure.js"
  },
  "scripts": {
    "validate": "node validate-docs-structure.js",
    "validate:critical": "node validate-docs-structure.js --only-critical",
    "test": "node validate-docs-structure.js --path . && node --test tools/test/*.test.mjs",
    "check": "node tools/build-manifest.mjs --check"
  },
  "dependencies": {
    "commander": "11.1.0",
    "github-slugger": "2.0.0",
    "hast-util-to-string": "3.0.1",
    "parse5": "7.3.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "4.5.0",
    "unified": "11.0.5",
    "yaml": "2.8.3"
  },
  "keywords": [
    "documentation",
    "validation",
    "jito",
    "markdown",
    "structure"
  ],
  "author": "Jito Foundation",
  "license": "MIT",
  "engines": {
    "node": ">=24.22.1 <25"
  }
}
